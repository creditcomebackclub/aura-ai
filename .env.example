DEEPSEEK_API_KEY=your_deepseek_api_key_here
XAI_API_KEY=your_xai_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_WEB_SEARCH_MODEL=gpt-5.4-mini
# Chat brain: openai | xai | deepseek. Vector memory + Whisper + live search
# always use OPENAI_API_KEY (embeddings + Luna), even when chat is xai/Grok.
AI_PROVIDER=xai
AURA_CHAT_MODEL=grok-4.5
AURA_MEMORY_MODEL=gpt-5.6-luna
# Voice STT. Default provider: deepgram when DEEPGRAM_API_KEY is set, else openai.
# Override with AURA_STT_PROVIDER=openai|deepgram.
AURA_STT_PROVIDER=
DEEPGRAM_API_KEY=
AURA_DEEPGRAM_MODEL=nova-3
# Live streaming endpointing (ms of silence → speech_final) and utterance_end.
# 400ms holds a mid-thought breath; 300 felt snappy but cut turns early.
AURA_DEEPGRAM_ENDPOINTING_MS=400
AURA_DEEPGRAM_UTTERANCE_END_MS=1200
# OpenAI fallback / default when Deepgram is unset.
# Default gpt-4o-mini-transcribe (faster than whisper-1 on live TTFA).
# Fallback to whisper-1 automatically if the chosen model is unavailable.
AURA_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Cartesia TTS. 24000 Hz is the latency-friendly default for voice turns.
AURA_TTS_MODEL=sonic-3.5
AURA_TTS_SAMPLE_RATE=24000
# Reasoning effort for tool-free rounds. Defaults: OpenAI none, xAI low.
# Tool rounds on GPT-5.6 already force none (required for function tools).
# Raise to medium/high only when you want slower, deeper answers.
AURA_REASONING_EFFORT=none
AURA_SUMMARY_MESSAGE_THRESHOLD=40
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Required to access AURA from another device on your LAN. Use a long random value.
AURA_ACCESS_TOKEN=replace_with_a_long_random_token
AURA_OWNER_ID=your_supabase_auth_user_id
# Used in morning-brief greeting ("Good morning, Chris"). Defaults to Chris.
AURA_OWNER_NAME=Chris
AURA_STATE_BACKEND=sqlite
AURA_RUNTIME=mac
AURA_AUTH_MODE=token
AURA_PUBLIC_URL=
AURA_COMPANION_DEVICE=chriss-macbook-pro
AURA_BIND_HOST=127.0.0.1
AURA_TIMEZONE=America/Phoenix
AURA_SCHEDULER_ENABLED=true
# Morning brief cron at 7:30 AM (AURA_TIMEZONE). Set false to disable the job.
AURA_DAILY_GOALS_DIGEST=true
# Combined morning brief (goals + calendar + Blackboard). Set false to fall
# back to goals-only digest text and restore Blackboard's own 7am upcoming alert.
AURA_MORNING_BRIEF=true
AURA_CRON_SECRET=
AURA_TAILSCALE_LOGIN=
AURA_WEB_SEARCH_CONTEXT=medium
AURA_WEB_SEARCH_TIMEOUT_MS=45000
AURA_WEB_SEARCH_DAILY_LIMIT=25
# Server-side stage timings for voice latency ([timing] whisper / first sentence /
# tts / memory). Browser always logs [timing] TTFA on a live voice turn.
AURA_TIMING_TRACE=false

# Direct cloud email. Use gmail or outlook after completing OAuth.
EMAIL_PROVIDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=

# Optional; stores raw Blackboard page text locally for debugging.
AURA_DEBUG_SCRAPES=false

# Recommended when Blackboard exposes "External calendar subscription" or iCal.
# Keep this private: it is usually a bearer-token URL.
BLACKBOARD_ICAL_URL=

# Personal calendar for today/tomorrow (credit consults, etc.). Prefer Google
# Calendar → Settings → Integrate calendar → "Secret address in iCal format"
# for the calendar that receives Calendly bookings. Keep this private — anyone
# with the URL can read the feed. When set, check_calendar + morning brief use
# it from cloud without needing the Mac awake. Alias: GOOGLE_CALENDAR_ICAL_URL.
CALENDAR_ICAL_URL=
# Google Calendar WRITE (propose_calendar_event / confirm_calendar_event).
# Needs OAuth with https://www.googleapis.com/auth/calendar.events scope.
# Falls back to GMAIL_CLIENT_ID/SECRET/REFRESH_TOKEN if these are unset.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Calendar id to write into (default primary).
GOOGLE_CALENDAR_ID=primary

# Required for AURA to email you. This is the ONLY possible recipient - it is
# never a tool argument the model can supply, by design. Sent via Apple Mail
# through the Mac companion (or directly if running locally on the Mac).
AURA_OWNER_EMAIL=

# Optional. Create a bot via @BotFather on Telegram to get a token, then
# message the bot once and check https://api.telegram.org/bot<token>/getUpdates
# to find your chat id. Required for AURA to message you on Telegram; the
# capability degrades gracefully (tool reports "not configured") if unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
