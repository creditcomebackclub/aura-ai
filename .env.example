DEEPSEEK_API_KEY=your_deepseek_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=openai
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Required to access AURA from another device on your LAN. Use a long random value.
AURA_ACCESS_TOKEN=replace_with_a_long_random_token
AURA_OWNER_ID=your_supabase_auth_user_id
AURA_STATE_BACKEND=sqlite
AURA_RUNTIME=mac
AURA_AUTH_MODE=token
AURA_PUBLIC_URL=
AURA_COMPANION_DEVICE=chriss-macbook-pro

# Direct cloud email. Use gmail or outlook after completing OAuth.
EMAIL_PROVIDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=

# Optional; stores raw Blackboard page text locally for debugging.
AURA_DEBUG_SCRAPES=false

# Recommended when Blackboard exposes "External calendar subscription" or iCal.
# Keep this private: it is usually a bearer-token URL.
BLACKBOARD_ICAL_URL=
